# ---------------------------------------------------------------------------
# .env - Variables de entorno para el servicio de reporte institucional
# NO subir este archivo a control de versiones con valores reales.
# Copiar como .env y reemplazar los placeholders.
# ---------------------------------------------------------------------------

# --- Base de datos: base_ebr_IA y vw_processing_brechas_ebr ---
DSN_DATOS=postgresql://usuario:password@host:5432/nombre_base_datos

# --- Base de datos: reportes_directivo y consultas_directivo (caché) ---
DSN_CACHE=postgresql://usuario:password@host:5432/nombre_base_cache

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=reemplazar_con_la_api_key_real
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=nombre_del_deployment

# --- RI3 ---
# La Matriz de análisis institucional es una fuente del RI3 (true). Con false queda fuera.
USAR_MATRIZ=true

# --- Moodle (Matriz de análisis institucional del RI3) ---
# Poner los valores reales SOLO en .env; nunca en el código ni en el repositorio.
MOODLE_BASE_URL=
MOODLE_SERVICE_PATH=/webservice/rest/server.php
MOODLE_TOKEN=
# Solo desarrollo: omite la verificación SSL hacia Moodle
MOODLE_DISABLE_SSL_VERIFY_DEV_ONLY=false
# Lectura de PDF con modelo de visión (más exacta en tablas sin líneas; usa más tokens)
MATRIZ_VISION=true

# Lectura de la Matriz con visión (RI3)
# Páginas transcritas en paralelo y tiempo máximo por página (segundos)
MATRIZ_VISION_CONCURRENCIA=8
TIMEOUT_VISION_S=180
